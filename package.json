{
  "name": "vi3-signaling-compact-test",
  "version": "1.0.0",
  "private": true,
  "description": "Автоматическая генерация index.compact.js из index.js",
  "main": "index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check:source": "node --check index.js",
    "compact:build": "node scripts/build-compact.js",
    "compact:check": "node scripts/check-compact.js",
    "compact:verify": "npm run check:source && npm run compact:build && npm run compact:check",
    "build": "npm run compact:verify"
  },
  "dependencies": {
    "ydb-sdk": "^5.9.0",
    "@yandex-cloud/nodejs-sdk": "^2.6.0"
  },
  "devDependencies": {
    "terser": "^5.31.6"
  }
}
